{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oh Tidepool reviewed media integrity manifest",
  "type": "object",
  "required": ["schema_version", "generated_at", "revision", "assets"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "revision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "assets": {
      "type": "object", "minProperties": 1, "maxProperties": 1000,
      "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "additionalProperties": {
        "type": "object", "required": ["revision", "path", "sha256", "content_type", "bytes"],
        "properties": {
          "revision": {"type": "integer", "minimum": 1},
          "path": {"type": "string", "pattern": "^media/[a-z0-9]+(?:-[a-z0-9]+)*-v[1-9][0-9]*\\.webp$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "content_type": {"const": "image/webp"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 20971520}
        }
      }
    }
  }
}
